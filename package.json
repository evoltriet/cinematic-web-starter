{
  "name": "cinematic-web-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:sanitize": "node scripts/check-sanitization.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:budgets && pnpm test:sanitize"
  },
  "dependencies": {
    "motion": "^13.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  }
}
